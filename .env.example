# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce?sslmode=disable
PORT=8080
# Optional: enables LLM-drafted replies. Without it, a template drafter is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Web (Vite)
VITE_API_URL=http://localhost:8080/graphql

# Mobile (Expo) - use your computer's LAN IP when testing on a phone
EXPO_PUBLIC_API_URL=http://localhost:8080/graphql
